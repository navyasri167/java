wordpress and web application 

version: '3.8'

services:

  wordpress:
    image: wordpress:latest
    container_name: wordpress-container
    ports:
      - "8080:80"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: student
      WORDPRESS_DB_PASSWORD: student123
      WORDPRESS_DB_NAME: college
    depends_on:
      - db

  db:
    image: mysql:8.0
    container_name: mysql-container
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: college
      MYSQL_USER: student
      MYSQL_PASSWORD: student123
    volumes:
      - db-data:/var/lib/mysql

volumes:
  db-data:
